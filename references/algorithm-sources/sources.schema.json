{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only external algorithm source manifest",
  "type": "object",
  "required": ["schema_version", "library_id", "description", "evidence_policy", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "library_id": {"const": "algorithm-sources-v1"},
    "description": {"type": "string", "minLength": 1},
    "evidence_policy": {
      "type": "object",
      "required": ["contest_evidence_eligible", "allowed_use", "forbidden_use", "original_code_in_repository"],
      "properties": {
        "contest_evidence_eligible": {"const": false},
        "allowed_use": {"type": "array", "items": {"type": "string"}, "minItems": 4, "uniqueItems": true},
        "forbidden_use": {"type": "array", "items": {"type": "string"}, "minItems": 6, "uniqueItems": true},
        "original_code_in_repository": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "repository", "commit", "commit_url", "language", "license_status", "scope", "source_paths", "last_checked"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
          "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "commit_url": {"type": "string", "format": "uri"},
          "language": {"type": "string", "minLength": 1},
          "license_status": {"type": "string", "enum": ["MIT", "Apache-2.0", "GPL-3.0", "NO_LICENSE", "UNKNOWN"]},
          "scope": {"type": "string", "enum": ["study_only", "adaptation_allowed", "verified_library"]},
          "source_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "last_checked": {"type": "string", "format": "date"},
          "mirror_mode": {"type": "string", "enum": ["git_clone", "local_directory"]},
          "local_content_policy": {"type": "string", "enum": ["byte_exact_upstream", "curated_derivative"]},
          "mirror_relpath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"},
          "index_relpath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
