{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric contract",
  "type": "object",
  "required": ["schema_version", "problem_id", "question_id", "source_question", "metrics", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "verification_profile": {"const": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "source_question": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "formula", "direction", "unit", "required", "baseline"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "formula": {"type": "string", "minLength": 1},
          "direction": {"enum": ["minimize", "maximize", "target", "report-only"]},
          "unit": {"type": "string", "minLength": 1},
          "numerator": {"type": "string"},
          "denominator": {"type": "string"},
          "aggregation": {"type": "string"},
          "time_window": {"type": "string"},
          "required": {"type": "boolean"},
          "baseline": {"type": "string", "minLength": 1},
          "reference_range": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "reference_source": {"type": "string"},
          "out_of_range_explanation": {"type": "string"},
          "target_definition": {"type": "string"},
          "horizon": {"type": "string"},
          "forecast_form": {"enum": ["point", "interval", "quantile", "distribution"]},
          "interval_definition": {"type": "string"},
          "reference_actual_locator": {"type": "string"},
          "run_metric_locator": {"type": "string"},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "table_ids": {"type": "array", "items": {"type": "string"}},
          "figure_ids": {"type": "array", "items": {"type": "string"}},
          "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_locator": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "validation_protocol": {
      "type": "object",
      "properties": {
        "status": {"enum": ["DRAFT", "READY", "VERIFIED", "STALE"]},
        "applicable": {"type": "boolean"},
        "not_applicable_reason": {"type": "string"},
        "strategy": {"enum": ["not-selected", "in-sample", "holdout", "rolling-origin", "grouped", "spatial-block", "nested", "scenario", "not-applicable"]},
        "split_unit": {"type": "string"},
        "holdout_scope": {"type": "string"},
        "leakage_checks": {"type": "array", "items": {"type": "string"}},
        "primary_metric_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "uncertainty_outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "metric_id", "operator"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "metric_id": {"type": "string", "minLength": 1},
              "comparator": {"enum": ["baseline", "threshold", "reference-range", "none"]},
              "operator": {"enum": ["less-than", "less-or-equal", "greater-than", "greater-or-equal", "within", "report-only"]},
              "threshold": {"type": ["number", "string"]},
              "rationale": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["threshold"]},
              {"required": ["rationale"]}
            ],
            "additionalProperties": false
          }
        },
        "evidence_locator": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["DRAFT", "READY", "LOCKED", "STALE"]}
  },
  "additionalProperties": false
}
