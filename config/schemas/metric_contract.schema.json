{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric contract",
  "type": "object",
  "required": ["schema_version", "problem_id", "question_id", "source_question", "metrics", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "source_question": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "metrics": {"type": "array", "items": {"type": "object", "required": ["id", "name", "formula", "direction", "unit", "required", "baseline"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "formula": {"type": "string", "minLength": 1}, "direction": {"enum": ["minimize", "maximize", "target", "report-only"]}, "unit": {"type": "string", "minLength": 1}, "numerator": {"type": "string"}, "denominator": {"type": "string"}, "aggregation": {"type": "string"}, "time_window": {"type": "string"}, "required": {"type": "boolean"}, "baseline": {"type": "string", "minLength": 1}, "reference_range": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "reference_source": {"type": "string"}, "out_of_range_explanation": {"type": "string"}, "target_definition": {"type": "string"}, "horizon": {"type": "string"}, "forecast_form": {"enum": ["point", "interval", "quantile", "distribution"]}, "interval_definition": {"type": "string"}, "reference_actual_locator": {"type": "string"}, "run_metric_locator": {"type": "string"}, "claim_ids": {"type": "array", "items": {"type": "string"}}, "table_ids": {"type": "array", "items": {"type": "string"}}, "figure_ids": {"type": "array", "items": {"type": "string"}}, "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_locator": {"type": "string"}}, "additionalProperties": false}},
    "status": {"enum": ["DRAFT", "READY", "LOCKED", "STALE"]}
  },
  "additionalProperties": false
}
