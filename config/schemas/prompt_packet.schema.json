{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assembled modeling prompt packet",
  "type": "object",
  "required": ["packet_version", "project_id", "stage", "gate", "gate_sequence", "role", "question_id", "objective", "read_scope", "write_scope", "context_refs", "blocking_conditions", "warning_conditions", "deferred_conditions", "allowed_actions", "stop_conditions", "input_contract", "protected_paths", "output_contract", "escalation_rules", "execution_semantics", "assembly_warnings"],
  "properties": {
    "packet_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "stage": {"enum": ["P0", "P1", "P2", "P3a", "P3b", "P4", "P5", "P6"]},
    "gate": {"pattern": "^G[0-6]$"},
    "gate_sequence": {"type": "array", "items": {"pattern": "^G[0-6]$"}, "minItems": 1, "uniqueItems": true},
    "role": {"enum": ["orchestrator", "solver", "literature", "visualization", "paper", "studio_release", "reviewer"]},
    "question_id": {"type": "string", "pattern": "^(|Q[1-9][0-9]*)$"},
    "objective": {"type": "string", "minLength": 1},
    "read_scope": {"type": "array", "items": {"type": "string"}},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "context_refs": {"type": "array", "items": {"type": "string"}},
    "blocking_conditions": {"type": "array", "items": {"type": "string"}},
    "warning_conditions": {"type": "array", "items": {"type": "string"}},
    "deferred_conditions": {"type": "array", "items": {"type": "string"}},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "input_contract": {"type": "array", "items": {"type": "string"}},
    "protected_paths": {"type": "array", "items": {"type": "string"}},
    "output_contract": {
      "type": "object",
      "required": ["format", "chat_format", "expected_artifacts", "role_outputs", "question_scope", "project_profile"],
      "properties": {
        "format": {"const": "compact_receipt"},
        "chat_format": {"const": "markdown_summary"},
        "expected_artifacts": {"type": "array", "items": {"type": "string"}},
        "role_outputs": {"type": "array", "items": {"type": "string"}},
        "question_scope": {"type": "string", "minLength": 1},
        "project_profile": {"type": "string", "minLength": 1},
        "shared_knowledge": {
          "type": "object",
          "required": ["index", "contest_evidence_eligible", "usage"],
          "properties": {
            "index": {"type": "string"},
            "contest_evidence_eligible": {"const": false},
            "usage": {"type": "string"},
            "solver_support": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "statistics_guidance": {
          "type": "object",
          "required": ["index", "modules", "cards", "route_ids", "expected_outputs", "contest_evidence_eligible", "usage"],
          "properties": {
            "index": {"type": "string"},
            "modules": {"type": "string"},
            "cards": {"type": "string"},
            "route_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "contest_evidence_eligible": {"const": false},
            "usage": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "algorithm_sources": {
          "type": "object",
          "required": ["mirror", "index", "index_relpath", "cards", "skeletons", "local_only", "sync_action", "contest_evidence_eligible", "usage"],
          "properties": {
            "mirror": {"type": "string"},
            "index": {"type": "string"},
            "index_relpath": {"type": "string"},
            "cards": {"type": "string"},
            "skeletons": {"type": "string"},
            "local_only": {"const": true},
            "sync_action": {"const": "sync"},
            "contest_evidence_eligible": {"const": false},
            "usage": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "escalation_rules": {"type": "array", "items": {"type": "string"}},
    "execution_semantics": {
      "type": "object",
      "required": ["warning", "blocking", "deferred", "hash_drift", "reaudit", "continuation", "note"],
      "properties": {
        "warning": {"const": "record-and-continue"},
        "blocking": {"const": "current-transition-only"},
        "deferred": {"const": "do-not-run-before-owner-stage"},
        "hash_drift": {"const": "affected-question-only"},
        "reaudit": {"const": "no-recursive-reaudit"},
        "continuation": {"const": "continue-editing-replay-and-recheckpoint"},
        "note": {"const": "当前检查只阻断本次阶段转换，不阻断本问题继续建模、修改、复跑或重新 checkpoint。"}
      },
      "additionalProperties": false
    },
    "assembly_warnings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "P0"}}}, "then": {"properties": {"gate": {"const": "G0"}, "gate_sequence": {"const": ["G0"]}, "role": {"enum": ["orchestrator"]}}}},
    {"if": {"properties": {"stage": {"const": "P1"}}}, "then": {"properties": {"gate": {"const": "G0"}, "gate_sequence": {"const": ["G0"]}, "role": {"enum": ["orchestrator", "solver", "literature", "paper"]}}}},
    {"if": {"properties": {"stage": {"const": "P2"}}}, "then": {"properties": {"gate": {"const": "G1"}, "gate_sequence": {"const": ["G1"]}, "role": {"enum": ["orchestrator", "solver", "literature"]}}}},
    {"if": {"properties": {"stage": {"const": "P3a"}}}, "then": {"properties": {"gate": {"const": "G1"}, "gate_sequence": {"const": ["G1"]}, "role": {"enum": ["orchestrator", "solver", "literature", "visualization"]}}}},
    {"if": {"properties": {"stage": {"const": "P3b"}}}, "then": {"properties": {"gate": {"const": "G2"}, "gate_sequence": {"const": ["G2"]}, "role": {"enum": ["orchestrator", "solver", "literature", "visualization"]}}}},
    {"if": {"properties": {"stage": {"const": "P4"}}}, "then": {"properties": {"gate": {"const": "G4"}, "gate_sequence": {"const": ["G3", "G4"]}, "role": {"enum": ["orchestrator", "solver", "paper", "reviewer"]}}}},
    {"if": {"properties": {"stage": {"const": "P5"}}}, "then": {"properties": {"gate": {"const": "G4"}, "gate_sequence": {"const": ["G4"]}, "role": {"enum": ["orchestrator", "paper", "visualization", "literature", "reviewer"]}}}},
    {"if": {"properties": {"stage": {"const": "P6"}}}, "then": {"properties": {"gate": {"const": "G6"}, "gate_sequence": {"const": ["G5", "G6"]}, "role": {"enum": ["orchestrator", "studio_release", "reviewer"]}}}},
    {
      "if": {"properties": {"stage": {"enum": ["P2", "P3a", "P3b", "P4", "P5", "P6"]}}},
      "then": {"properties": {"question_id": {"pattern": "^Q[1-9][0-9]*$"}}}
    }
  ],
  "additionalProperties": false
}
