{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configured modeling experiment",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "commonProperties": {
      "experiment_id": {"type": "string", "minLength": 1},
      "problem": {"type": "string", "minLength": 1},
      "question": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
      "engine": {"enum": ["python", "matlab"]},
      "runner": {"type": "string", "minLength": 1},
      "seed": {"type": "integer"},
      "output_root": {"type": "string", "minLength": 1},
      "arguments": {"type": "array", "items": {"type": "string"}},
      "methods": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["name", "role"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "role": {"enum": ["main", "baseline", "fallback", "diagnostic"]}
          },
          "additionalProperties": true
        }
      },
      "inputs": {"type": "array", "items": {"type": "string"}},
      "metrics": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "unit"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "unit": {"type": "string"},
            "locator": {"type": "string"},
            "primary": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      }
    },
    "v1": {
      "type": "object",
      "required": ["schema_version", "experiment_id", "problem", "question", "engine", "runner", "seed", "output_root", "arguments", "methods", "inputs", "metrics"],
      "properties": {
        "schema_version": {"const": 1},
        "experiment_id": {"type": "string"},
        "problem": {"type": "string"},
        "question": {"type": "string"},
        "engine": {"enum": ["python", "matlab"]},
        "runner": {"type": "string"},
        "seed": {"type": "integer"},
        "output_root": {"type": "string"},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "methods": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "v2": {
      "type": "object",
      "required": ["schema_version", "experiment_id", "problem", "question", "engine", "runner", "seed", "output_root", "arguments", "diagnostic_arguments", "methods", "inputs", "metrics", "run_mode", "level", "mode", "purpose", "formal_candidate", "checks", "reuse_contract", "replay"],
      "properties": {
        "schema_version": {"const": 2},
        "experiment_id": {"$ref": "#/$defs/commonProperties/experiment_id"},
        "problem": {"$ref": "#/$defs/commonProperties/problem"},
        "question": {"$ref": "#/$defs/commonProperties/question"},
        "engine": {"$ref": "#/$defs/commonProperties/engine"},
        "runner": {"$ref": "#/$defs/commonProperties/runner"},
        "seed": {"$ref": "#/$defs/commonProperties/seed"},
        "output_root": {"$ref": "#/$defs/commonProperties/output_root"},
        "arguments": {"$ref": "#/$defs/commonProperties/arguments"},
        "diagnostic_arguments": {"type": "array", "items": {"type": "string"}},
        "methods": {"$ref": "#/$defs/commonProperties/methods"},
        "inputs": {"$ref": "#/$defs/commonProperties/inputs"},
        "metrics": {"$ref": "#/$defs/commonProperties/metrics"},
        "run_mode": {"enum": ["scratch", "candidate", "formal", "paper-evidence"]},
        "level": {"enum": ["scratch", "candidate", "formal", "paper-evidence"]},
        "mode": {"enum": ["probe", "formal"]},
        "purpose": {"enum": ["exploration", "candidate", "paper"]},
        "formal_candidate": {"type": "boolean"},
        "parent_run_id": {"type": ["string", "null"]},
        "source_run_id": {"type": ["string", "null"]},
        "source_manifest": {"type": ["string", "null"]},
        "source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evidence_scope": {"type": ["string", "null"], "enum": [null, "diagnostic", "sensitivity", "mechanism", "figure_support"]},
        "checkpoint_id": {"type": ["string", "null"]},
        "primary_metric": {"type": ["string", "null"]},
        "checks": {"$ref": "#/$defs/checks"},
        "reuse_contract": {
          "type": "object",
          "required": ["seed", "environment", "code", "inputs", "methods", "parameters"],
          "properties": {
            "seed": {"type": "boolean"},
            "environment": {"type": "boolean"},
            "code": {"type": "boolean"},
            "inputs": {"type": "boolean"},
            "methods": {"type": "boolean"},
            "parameters": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "replay": {
          "type": "object",
          "required": ["required", "count"],
          "properties": {
            "required": {"type": "boolean"},
            "count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["input_output_match", "units_defined", "core_constraints_passed", "deterministic", "baseline_comparable"],
      "properties": {
        "input_output_match": {"type": "boolean"},
        "units_defined": {"type": "boolean"},
        "core_constraints_passed": {"type": "boolean"},
        "deterministic": {"type": "boolean"},
        "baseline_comparable": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
