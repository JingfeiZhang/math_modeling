{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.math-modeling/literature-search-plan.schema.json",
  "title": "Question-scoped academic literature search plan",
  "type": "object",
  "required": [
    "schema_version", "plan_id", "problem_id", "question_id", "source_question_manifest",
    "source_question_manifest_sha256", "domain_problem", "math_task", "data_features",
    "key_constraints", "queries", "source_priority", "time_budget", "screening",
    "status", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^litplan-[a-z0-9._-]+$"},
    "problem_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "source_question_manifest": {"$ref": "#/$defs/relativePath"},
    "source_question_manifest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the canonical question interface after removing the top-level literature block."
    },
    "domain_problem": {
      "type": "object",
      "required": ["subject", "context", "research_question"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "research_question": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "math_task": {
      "type": "object",
      "required": ["type", "inputs", "outputs"],
      "properties": {
        "type": {
          "enum": [
            "prediction", "evaluation", "optimization", "classification", "scheduling",
            "mechanism", "clustering", "statistical-inference", "network", "other"
          ]
        },
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "data_features": {
      "type": "object",
      "required": ["sample_scale", "temporal_granularity", "spatial_granularity", "variable_types", "missingness"],
      "properties": {
        "sample_scale": {"type": "string", "minLength": 1},
        "temporal_granularity": {"type": "string", "minLength": 1},
        "spatial_granularity": {"type": "string", "minLength": 1},
        "variable_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missingness": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "key_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "queries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["query_id", "kind", "language", "query", "rationale"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^query-[a-z0-9._-]+$"},
          "kind": {"enum": ["scenario-task", "method-constraint", "follow-up"]},
          "language": {"enum": ["zh", "en"]},
          "query": {"type": "string", "minLength": 3},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "source_priority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/provider"}
    },
    "time_budget": {
      "type": "object",
      "required": ["per_question_minutes", "project_total_minutes", "stop_when_budget_exhausted"],
      "properties": {
        "per_question_minutes": {"type": "integer", "minimum": 1, "maximum": 20},
        "project_total_minutes": {"type": "integer", "minimum": 1, "maximum": 90},
        "stop_when_budget_exhausted": {"const": true}
      },
      "additionalProperties": false
    },
    "screening": {
      "type": "object",
      "required": [
        "max_candidates", "target_read_min", "target_read_max", "expansion_read_max",
        "ranking_criteria", "publication_types", "contest_papers_allowed"
      ],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
        "target_read_min": {"type": "integer", "minimum": 2, "maximum": 4},
        "target_read_max": {"type": "integer", "minimum": 2, "maximum": 4},
        "expansion_read_max": {"type": "integer", "minimum": 4, "maximum": 6},
        "ranking_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "publication_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["journal-article", "conference-paper", "preprint", "thesis"]}
        },
        "contest_papers_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["PLAN_READY", "STALE"]},
    "created_at_utc": {"$ref": "#/$defs/dateTime"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    },
    "dateTime": {"type": "string", "format": "date-time"},
    "provider": {
      "enum": [
        "crossref", "openalex", "arxiv", "semantic-scholar", "manual-google-scholar",
        "manual-cnki", "manual-wanfang", "user-supplied"
      ]
    }
  }
}
