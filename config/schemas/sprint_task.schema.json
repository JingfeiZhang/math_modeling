{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped multi-agent sprint task package",
  "type": "object",
  "required": ["schema_version", "sprint_id", "task_id", "role", "problem", "question", "status", "attempt", "max_attempts", "dependencies", "input_hashes", "allowed_read_paths", "write_directory", "expected_outputs", "target_gate", "deadline_utc", "root_only_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "sprint_id": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "role": {"enum": ["solver", "figure", "writer", "reviewer"]},
    "problem": {"type": "string"},
    "question": {"type": "string"},
    "status": {"enum": ["PENDING", "RUNNING", "COMPLETE", "FAILED", "INTERRUPTED"]},
    "attempt": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fingerprint"}},
    "allowed_read_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "write_directory": {"type": "string"},
    "expected_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "target_gate": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]},
    "deadline_utc": {"type": "string"},
    "root_only_paths": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}
    ,"sprint_profile": {"enum": ["default", "q1-solve", "q1-compose"]}
    ,"input_sprint_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": ["path", "kind", "exists", "sha256"],
      "properties": {"path": {"type": "string"}, "kind": {"enum": ["file", "directory", "missing"]}, "exists": {"type": "boolean"}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
