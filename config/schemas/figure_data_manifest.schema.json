{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.math-modeling/figure-data-manifest.schema.json",
  "title": "Figure data handoff manifest",
  "type": "object",
  "required": [
    "schema_version", "manifest_id", "problem_id", "question_id", "run_id", "level", "status",
    "source_run_manifest", "source_run_manifest_sha256", "source_artifacts", "data_profile",
    "comparators", "uncertainty", "read_only_transformations", "reader_question",
    "claim_candidates", "paper_targets", "contest_evidence_eligible"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^figdata-[A-Za-z0-9._-]+$"},
    "problem_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "level": {"enum": ["scratch", "candidate", "formal", "paper-evidence"]},
    "status": {"enum": ["DATA_READY", "STALE"]},
    "source_run_manifest": {"$ref": "#/$defs/relativePath"},
    "source_run_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "fields"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "data_profile": {
      "type": "object",
      "required": ["row_count", "column_count", "variable_types", "units", "observation_unit", "missingness"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 0},
        "column_count": {"type": "integer", "minimum": 1},
        "variable_types": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "observation_unit": {"type": "string", "minLength": 1},
        "missingness": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "comparators": {
      "type": "object",
      "required": ["baseline", "thresholds"],
      "properties": {
        "baseline": {"type": "string", "minLength": 1},
        "thresholds": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["definition", "observation_or_replication_unit"],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "observation_or_replication_unit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "read_only_transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reader_question": {"type": "string", "minLength": 1},
    "claim_candidates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "paper_targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contest_evidence_eligible": {"type": "boolean"},
    "created_at_utc": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"level": {"enum": ["scratch", "candidate"]}}, "required": ["level"]},
      "then": {"properties": {"contest_evidence_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"level": {"enum": ["formal", "paper-evidence"]}}, "required": ["level"]},
      "then": {"properties": {"contest_evidence_eligible": {"const": true}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    }
  }
}
