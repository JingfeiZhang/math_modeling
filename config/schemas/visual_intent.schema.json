{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.math-modeling/visual-intent.schema.json",
  "title": "Lightweight visualization intent",
  "type": "object",
  "required": [
    "schema_version", "intent_id", "question_id", "run_id", "source_data_manifest",
    "source_data_manifest_sha256", "reader_question", "evidence_role", "artifact_decision",
    "candidate_archetypes", "required_encodings", "comparison", "risks", "paper_slot",
    "status", "contest_evidence_eligible"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "intent_id": {"type": "string", "pattern": "^intent-[A-Za-z0-9._-]+$"},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "source_data_manifest": {"$ref": "#/$defs/relativePath"},
    "source_data_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reader_question": {"type": "string", "minLength": 1},
    "evidence_role": {"enum": ["main", "mechanism", "robustness", "limitation", "diagnostic", "exploratory"]},
    "artifact_decision": {"enum": ["figure", "table", "text", "none"]},
    "candidate_archetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "rationale", "rejection_reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "rejection_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "required_encodings": {
      "type": "object",
      "required": ["x", "y", "group", "secondary"],
      "properties": {
        "x": {"type": ["string", "null"]},
        "y": {"type": ["string", "null"]},
        "group": {"type": ["string", "null"]},
        "secondary": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "comparison": {"type": "string", "minLength": 1},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "paper_slot": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "READY", "STALE"]},
    "contest_evidence_eligible": {"type": "boolean"},
    "created_at_utc": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    }
  }
}
