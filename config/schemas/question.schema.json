{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modeling competition subproblem evidence package",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "method": {
      "type": "object",
      "required": ["name", "rationale", "implementation"],
      "properties": {
        "name": {"type": "string"},
        "rationale": {"type": "string"},
        "implementation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["name", "implementation", "comparable_output"],
      "properties": {
        "name": {"type": "string"},
        "implementation": {"type": "string"},
        "comparable_output": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "required": ["name", "trigger"],
      "properties": {
        "name": {"type": "string"},
        "trigger": {"type": "string"}
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["DRAFT", "SCREENED", "HUMAN_DECIDED", "RUN", "FROZEN", "PAPER_READY"]
    },
    "literatureRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"},
        "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "literature": {
      "type": "object",
      "required": ["search_plan", "search_receipts", "evidence_cards", "model_evidence_brief", "bib_keys", "status"],
      "properties": {
        "search_plan": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/literatureRef"}]},
        "search_receipts": {"type": "array", "items": {"$ref": "#/$defs/literatureRef"}, "uniqueItems": true},
        "evidence_cards": {"type": "array", "items": {"$ref": "#/$defs/literatureRef"}, "uniqueItems": true},
        "model_evidence_brief": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/literatureRef"}]},
        "bib_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "status": {"enum": ["NOT_STARTED", "PLAN_READY", "DISCOVERED", "SOURCES_VERIFIED", "CARDS_READY", "SYNTHESIS_READY", "CITATION_READY", "STALE"]}
      },
      "additionalProperties": false
    },
    "qualityContractRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "qualityContracts": {
      "type": "object",
      "required": ["semantics", "metrics", "algorithm_evidence", "abstract"],
      "properties": {
        "semantics": {"$ref": "#/$defs/qualityContractRef"},
        "metrics": {"$ref": "#/$defs/qualityContractRef"},
        "algorithm_evidence": {"$ref": "#/$defs/qualityContractRef"},
        "abstract": {"$ref": "#/$defs/qualityContractRef"}
      },
      "additionalProperties": false
    },
    "v1": {
      "type": "object",
      "required": ["schema_version", "problem_id", "question_id", "problem", "method", "assumptions", "risk_probes", "decisions", "evidence", "paper", "status"],
      "properties": {
        "schema_version": {"const": 1},
        "problem_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "source_problem": {"type": "string"},
        "problem": {
          "type": "object",
          "required": ["target", "inputs", "constraints", "evaluation_metrics"],
          "properties": {
            "target": {"type": "string"},
            "inputs": {"type": "array", "items": {"type": "string"}},
            "constraints": {"type": "array", "items": {"type": "string"}},
            "evaluation_metrics": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "method": {
          "type": "object",
          "required": ["main", "baseline", "fallback"],
          "properties": {
            "main": {"$ref": "#/$defs/method"},
            "baseline": {"$ref": "#/$defs/baseline"},
            "fallback": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fallback"}]}
          },
          "additionalProperties": false
        },
        "assumptions": {"type": "array", "items": {"type": "object"}},
        "risk_probes": {"type": "array", "items": {"type": "object"}},
        "decisions": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "object"},
        "paper": {"type": "object"},
        "status": {"$ref": "#/$defs/status"}
      },
      "additionalProperties": false
    },
    "v2": {
      "type": "object",
      "required": ["schema_version", "problem_id", "question_id", "source_problem", "problem", "model_selection", "method", "assumptions", "risk_probes", "decisions", "evidence", "paper", "status"],
      "properties": {
        "schema_version": {"enum": [2, 3]},
        "problem_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "source_problem": {"type": "string"},
        "problem": {
          "type": "object",
          "required": ["target", "type", "inputs", "outputs", "constraints", "evaluation_metrics", "dependencies", "key_conflicts"],
          "properties": {
            "target": {"type": "string"},
            "type": {"type": "string"},
            "inputs": {"type": "array", "items": {"type": "string"}},
            "outputs": {"type": "array", "items": {"type": "string"}},
            "constraints": {"type": "array", "items": {"type": "string"}},
            "evaluation_metrics": {"type": "array", "items": {"type": "string"}},
            "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^Q[1-9][0-9]*$"}},
            "key_conflicts": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "model_selection": {
          "type": "object",
          "required": ["primary", "rationale", "baseline", "rejected_alternatives"],
          "properties": {
            "primary": {"type": "string"},
            "rationale": {"type": "string"},
            "baseline": {"type": "string"},
            "rejected_alternatives": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "method": {
          "type": "object",
          "required": ["main", "baseline", "fallback"],
          "properties": {
            "main": {"$ref": "#/$defs/method"},
            "baseline": {"$ref": "#/$defs/baseline"},
            "fallback": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fallback"}]}
          },
          "additionalProperties": false
        },
        "assumptions": {"type": "array", "items": {"type": "object"}},
        "risk_probes": {"type": "array", "items": {"type": "object"}},
        "decisions": {"type": "array", "items": {"type": "object"}},
        "evidence": {
          "type": "object",
          "required": ["runs", "paper_evidence_runs", "robustness", "figures", "result_claim_ids", "validation_claim_ids", "boundary_claim_ids"],
          "properties": {
            "runs": {"type": "array", "items": {"type": "string"}},
            "paper_evidence_runs": {"type": "array", "items": {"type": "string"}},
            "robustness": {"type": "string"},
            "figures": {"type": "array", "items": {"type": "string"}},
            "result_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "validation_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "boundary_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "paper": {
          "type": "object",
          "required": ["section", "table_ids", "figure_ids", "code_refs", "downstream_interfaces", "argument_contract"],
          "properties": {
            "section": {"type": "string", "pattern": "^sections/question_[1-9][0-9]*\\.tex$"},
            "table_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "figure_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "code_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "downstream_interfaces": {"type": "array", "items": {"type": "string"}},
            "argument_contract": {
              "type": "object",
              "required": ["objective_interface", "model_choice", "formulation", "algorithm", "result", "validation", "conclusion"],
              "properties": {
                "objective_interface": {"enum": ["pending", "complete"]},
                "model_choice": {"enum": ["pending", "complete"]},
                "formulation": {"enum": ["pending", "complete"]},
                "algorithm": {"enum": ["pending", "complete"]},
                "result": {"enum": ["pending", "complete"]},
                "validation": {"enum": ["pending", "complete"]},
                "conclusion": {"enum": ["pending", "complete"]}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "literature": {"$ref": "#/$defs/literature"},
        "quality_contracts": {"$ref": "#/$defs/qualityContracts"},
        "status": {"$ref": "#/$defs/status"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"schema_version": {"const": 3}}},
          "then": {"required": ["literature"]}
        }
      ]
    }
  }
}
