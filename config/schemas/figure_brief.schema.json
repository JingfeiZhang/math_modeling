{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.math-modeling/figure-brief.schema.json",
  "title": "Evidence-bound visualization design brief",
  "type": "object",
  "required": [
    "schema_version", "brief_id", "question_id", "run_id", "source_data_manifest",
    "source_data_manifest_sha256", "visual_intent", "visual_intent_sha256", "claim_id",
    "core_conclusion", "core_message", "evidence_chain", "decision", "encodings", "visual_hierarchy", "panel_map", "labels",
    "legend", "palette_id", "color_encoding", "backend", "target_size_profile", "final_width_mm",
    "min_font_pt", "source_data", "source_script", "source_script_sha256", "outputs", "baseline", "axes", "caption",
    "statistics", "statistics_report", "data_integrity", "label_strategy", "rasterized_layers",
    "review_risks", "read_only_transformations", "status", "qa_expectations",
    "contest_evidence_eligible"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "brief_id": {"type": "string", "pattern": "^fig-[a-z0-9-]+$"},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "source_data_manifest": {"$ref": "#/$defs/relativePath"},
    "source_data_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "visual_intent": {"$ref": "#/$defs/relativePath"},
    "visual_intent_sha256": {"$ref": "#/$defs/sha256"},
    "claim_id": {"type": ["string", "null"]},
    "core_conclusion": {"type": "string", "minLength": 1},
    "core_message": {"type": "string", "minLength": 1},
    "evidence_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locator", "sha256", "fields"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": ["artifact_type", "archetype", "alternatives", "rationale"],
      "properties": {
        "artifact_type": {"const": "figure"},
        "archetype": {"type": "string", "minLength": 1},
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["kind", "rejected_reason"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "rejected_reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "encodings": {
      "type": "object",
      "required": ["x", "y", "color", "marker", "facet", "units"],
      "properties": {
        "x": {"type": ["string", "null"]},
        "y": {"type": ["string", "null"]},
        "color": {"type": ["string", "null"]},
        "marker": {"type": ["string", "null"]},
        "facet": {"type": ["string", "null"]},
        "units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "visual_hierarchy": {
      "type": "object",
      "required": ["primary_evidence", "secondary_context", "deemphasized"],
      "properties": {
        "primary_evidence": {"type": "string", "minLength": 1},
        "secondary_context": {"type": "string", "minLength": 1},
        "deemphasized": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "panel_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["panel", "role", "subclaim"],
        "properties": {
          "panel": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "subclaim": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "multipanel_justification": {"type": "string", "minLength": 1},
    "labels": {
      "type": "object",
      "required": ["strategy", "collision_check_required"],
      "properties": {
        "strategy": {"enum": ["direct", "external-legend", "none"]},
        "collision_check_required": {"const": true},
        "annotations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "legend": {"type": "string", "minLength": 1},
    "palette_id": {"const": "journal-spectrum-v2"},
    "color_encoding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "meaning", "secondary_encoding"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "secondary_encoding": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "backend": {"enum": ["python", "matlab", "mermaid", "drawio"]},
    "target_size_profile": {"enum": ["contest-body", "journal-single", "journal-double"]},
    "final_width_mm": {"type": "number", "minimum": 40, "maximum": 190},
    "min_font_pt": {"type": "number", "minimum": 8},
    "source_data": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}},
    "source_script": {"$ref": "#/$defs/relativePath"},
    "source_script_sha256": {"$ref": "#/$defs/sha256"},
    "render_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {
      "type": "object",
      "required": ["pdf", "svg", "png", "png_dpi"],
      "properties": {
        "pdf": {"$ref": "#/$defs/relativePath"},
        "svg": {"$ref": "#/$defs/relativePath"},
        "png": {"$ref": "#/$defs/relativePath"},
        "png_dpi": {"const": 400}
      },
      "additionalProperties": false
    },
    "baseline": {"type": "string", "minLength": 1},
    "axes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["variable", "unit"],
        "properties": {
          "variable": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "caption": {"type": "string", "minLength": 1},
    "statistics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "statistics_report": {
      "type": "object",
      "required": ["sample_size", "center", "interval", "test", "multiplicity"],
      "properties": {
        "sample_size": {"type": "string", "minLength": 1},
        "center": {"type": "string", "minLength": 1},
        "interval": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "multiplicity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "data_integrity": {
      "type": "object",
      "required": ["source_hashes", "transformation", "manual_values_forbidden"],
      "properties": {
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        },
        "transformation": {"type": "string", "minLength": 1},
        "manual_values_forbidden": {"const": true}
      },
      "additionalProperties": false
    },
    "label_strategy": {
      "type": "object",
      "required": ["mode", "collision_checked"],
      "properties": {
        "mode": {"enum": ["direct", "external-legend", "none"]},
        "collision_checked": {"type": "boolean"},
        "justification": {"type": "string"}
      },
      "additionalProperties": false
    },
    "rasterized_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "reason"],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "read_only_transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["DRAFT", "REVIEWED", "APPROVED", "RENDERED", "QA_PASSED", "CONTRACT_READY", "STALE"]},
    "qa_expectations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval": {
      "type": "object",
      "required": ["decision_id", "approved_by", "approved_at_utc"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "approved_by": {"const": "root-agent"},
        "approved_at_utc": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "contest_evidence_eligible": {"type": "boolean"},
    "created_at_utc": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["APPROVED", "RENDERED", "QA_PASSED", "CONTRACT_READY"]}}},
      "then": {"required": ["approval"]}
    },
    {
      "if": {"properties": {"panel_map": {"minItems": 2}}},
      "then": {"required": ["multipanel_justification"]}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    }
  }
}
