{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.math-modeling/model-evidence-brief.schema.json",
  "title": "Academic evidence matrix for a modeling decision",
  "type": "object",
  "required": [
    "schema_version", "brief_id", "problem_id", "question_id", "source_question_manifest",
    "source_question_manifest_sha256", "source_cards", "candidates", "recommendation",
    "experiment_feedback", "citation_handoff", "literature_conflicts", "model_review_signal",
    "evidence_policy", "status", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "brief_id": {"type": "string", "pattern": "^litevidence-[a-z0-9._-]+$"},
    "problem_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "source_question_manifest": {"$ref": "#/$defs/relativePath"},
    "source_question_manifest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the canonical question interface after removing the top-level literature block."
    },
    "source_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["card_id", "path", "sha256", "review_depth", "bibliographic_status", "bibtex_key"],
        "properties": {
          "card_id": {"type": "string", "pattern": "^litcard-[a-z0-9._-]+$"},
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "review_depth": {"enum": ["METADATA_ONLY", "ABSTRACT_SCREENED", "TARGETED_READ", "DEEP_READ"]},
          "bibliographic_status": {"enum": ["VERIFIED", "CONFLICT", "REJECTED"]},
          "bibtex_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$"}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "model_name", "evidence_roles", "fit_to_current_problem",
          "implementation", "baseline", "risk_probes", "rejected_when", "decision"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^model-[a-z0-9._-]+$"},
          "model_name": {"type": "string", "minLength": 1},
          "evidence_roles": {
            "type": "object",
            "required": ["model_family", "mechanism", "parameter", "validation"],
            "properties": {
              "model_family": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "mechanism": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "parameter": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "validation": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "fit_to_current_problem": {
            "type": "object",
            "required": ["matched_conditions", "mismatched_conditions"],
            "properties": {
              "matched_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "mismatched_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "implementation": {
            "type": "object",
            "required": ["expected_runtime", "dependencies"],
            "properties": {
              "expected_runtime": {"type": "string", "minLength": 1},
              "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "baseline": {"type": "string", "minLength": 1},
          "risk_probes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "rejected_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "decision": {"enum": ["retain", "reject", "fallback"]}
        },
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["primary_candidate", "rationale", "baseline", "fallback", "rejected_alternatives"],
      "properties": {
        "primary_candidate": {"type": "string", "pattern": "^model-[a-z0-9._-]+$"},
        "rationale": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "minLength": 1},
        "fallback": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["candidate_id", "activation_trigger"],
              "properties": {
                "candidate_id": {"type": "string", "pattern": "^model-[a-z0-9._-]+$"},
                "activation_trigger": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidate_id", "reason"],
            "properties": {
              "candidate_id": {"type": "string", "pattern": "^model-[a-z0-9._-]+$"},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "experiment_feedback": {
      "type": "object",
      "required": ["scratch_experiments", "risk_probes"],
      "properties": {
        "scratch_experiments": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk_probes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "citation_handoff": {
      "type": "object",
      "required": ["bibtex_keys", "paper_targets", "differences_from_literature"],
      "properties": {
        "bibtex_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$"}
        },
        "paper_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bibtex_key", "section", "purpose", "minimum_review_depth"],
            "properties": {
              "bibtex_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$"},
              "section": {"enum": ["problem-analysis", "model-selection", "parameter-basis", "model-validation"]},
              "purpose": {"type": "string", "minLength": 1},
              "minimum_review_depth": {"enum": ["TARGETED_READ", "DEEP_READ"]}
            },
            "additionalProperties": false
          }
        },
        "differences_from_literature": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "literature_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "description", "severity", "resolution_status", "resolution"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high"]},
          "resolution_status": {"enum": ["unresolved", "resolved", "deferred"]},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "model_review_signal": {"enum": ["NONE", "MODEL_REVIEW_SUGGESTED", "RESOLVED"]},
    "evidence_policy": {
      "type": "object",
      "required": [
        "academic_sources_only", "contest_papers_excluded", "external_results_are_not_project_claims",
        "project_numbers_from_frozen_evidence_only"
      ],
      "properties": {
        "academic_sources_only": {"const": true},
        "contest_papers_excluded": {"const": true},
        "external_results_are_not_project_claims": {"const": true},
        "project_numbers_from_frozen_evidence_only": {"const": true}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["SYNTHESIS_READY", "CITATION_READY", "STALE"]},
    "created_at_utc": {"$ref": "#/$defs/dateTime"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    },
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
