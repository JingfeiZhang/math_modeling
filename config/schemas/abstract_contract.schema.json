{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abstract and result synthesis contract",
  "type": "object",
  "required": ["schema_version", "problem_id", "source_question_set", "question_count", "background", "questions", "final_summary", "forbidden_terms", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "source_question_set": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "question_count": {"type": "integer", "minimum": 1},
    "background": {"type": "object", "required": ["paragraphs", "max_lines"], "properties": {"paragraphs": {"const": 1}, "max_lines": {"enum": [3, 4]}}, "additionalProperties": false},
    "questions": {"type": "array", "items": {"type": "object", "required": ["question_id", "method_required", "subject_required", "conclusion_required", "validation_required", "boundary_required", "claim_ids"], "properties": {"question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"}, "method_required": {"type": "boolean"}, "subject_required": {"type": "boolean"}, "conclusion_required": {"type": "boolean"}, "validation_required": {"type": "boolean"}, "boundary_required": {"type": "boolean"}, "method": {"type": "string"}, "subject": {"type": "string"}, "conclusion": {"type": "string"}, "validation": {"type": "string"}, "boundary": {"type": "string"}, "claim_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "final_summary": {"type": "object", "required": ["contribution", "limitation"], "properties": {"contribution": {"type": "string"}, "limitation": {"type": "string"}}, "additionalProperties": false},
    "forbidden_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "result_slots": {"type": "array", "items": {"type": "object", "required": ["slot_id", "question_id", "claim_ids", "unit"], "properties": {"slot_id": {"type": "string"}, "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"}, "claim_ids": {"type": "array", "items": {"type": "string"}}, "unit": {"type": "string"}}, "additionalProperties": false}},
    "status": {"enum": ["DRAFT", "READY", "LOCKED", "STALE"]}
  },
  "additionalProperties": false
}
