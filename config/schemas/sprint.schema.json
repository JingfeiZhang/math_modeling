{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit multi-agent competition sprint",
  "type": "object",
  "required": ["schema_version", "sprint_id", "problem", "agent_mode", "max_agents", "status", "created_at_utc", "deadline_utc", "state_input", "protected_snapshot", "task_files", "root_only_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "sprint_id": {"type": "string", "pattern": "^sprint-[A-Za-z0-9._-]+$"},
    "problem": {"type": "string", "minLength": 1},
    "agent_mode": {"const": "parallel"},
    "max_agents": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["PREPARED", "MERGED", "PARTIAL", "BLOCKED"]},
    "created_at_utc": {"type": "string", "minLength": 1},
    "deadline_utc": {"type": "string"},
    "state_input": {"$ref": "#/$defs/fileHash"},
    "protected_snapshot": {"type": "array", "items": {"$ref": "#/$defs/fingerprint"}},
    "task_files": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "root_only_paths": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "profile": {"enum": ["default", "q1-solve", "q1-compose"]},
    "question": {"type": ["string", "null"]},
    "input_sprint_id": {"type": ["string", "null"]},
    "last_merge_report": {"type": "string"}
  },
  "$defs": {
    "fileHash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "object",
      "required": ["path", "kind", "exists", "sha256"],
      "properties": {"path": {"type": "string"}, "kind": {"enum": ["file", "directory", "missing"]}, "exists": {"type": "boolean"}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
