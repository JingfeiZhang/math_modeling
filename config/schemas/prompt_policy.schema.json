{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mathematical modeling prompt policy",
  "type": "object",
  "required": ["schema_version", "locale", "mode", "authority_order", "shared_knowledge", "statistics_guidance", "algorithm_sources", "academic_quality", "response", "stages", "roles", "role_stages", "gate_sequence", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "locale": {"const": "zh-CN"},
    "mode": {"const": "progress-first"},
    "authority_order": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "prefixItems": [
        {"const": "official_rules"}, {"const": "project_contest_profile"}, {"const": "prompt_policy"},
        {"const": "question_manifest"}, {"const": "formal_evidence"}, {"const": "candidate_evidence"},
        {"const": "scratch_evidence"}, {"const": "external_literature"}
      ],
      "items": false
    },
    "shared_knowledge": {
      "type": "object",
      "required": ["index", "phases", "solver_roles", "literature_roles", "contest_evidence_eligible", "formal_stages"],
      "properties": {
        "index": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "phases": {"type": "array", "items": {"enum": ["P1", "P2", "P3a", "P3b"]}, "uniqueItems": true},
        "solver_roles": {"type": "array", "items": {"const": "solver"}, "minItems": 1, "uniqueItems": true},
        "literature_roles": {"type": "array", "items": {"const": "literature"}, "minItems": 1, "uniqueItems": true},
        "contest_evidence_eligible": {"const": false},
        "formal_stages": {"type": "array", "items": {"enum": ["P4", "P5", "P6"]}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "statistics_guidance": {
      "type": "object",
      "required": ["index", "modules", "cards", "phases", "roles", "contest_evidence_eligible", "missing_behavior", "routes", "stage_routes"],
      "properties": {
        "index": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "modules": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "cards": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "phases": {"const": ["P1", "P2", "P3a", "P3b"]},
        "roles": {"const": ["solver"]},
        "contest_evidence_eligible": {"const": false},
        "missing_behavior": {"const": "warning"},
        "routes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["data_profile", "relation_selection", "assumption_diagnostics", "effect_size_interval", "result_interpretation_boundary"]}
        },
        "stage_routes": {
          "type": "object",
          "required": ["P1", "P2", "P3a", "P3b"],
          "properties": {
            "P1": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "P2": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "P3a": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "P3b": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "algorithm_sources": {
      "type": "object",
      "required": ["mirror", "index", "index_relpath", "sources", "cards", "skeletons", "quality_standard", "phases", "roles", "contest_evidence_eligible", "formal_stages", "local_only", "sync_action"],
      "properties": {
        "mirror": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "index": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "index_relpath": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "sources": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "cards": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "skeletons": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "quality_standard": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "phases": {"type": "array", "items": {"enum": ["P1", "P2", "P3a", "P3b"]}, "uniqueItems": true},
        "roles": {"const": ["solver"]},
        "contest_evidence_eligible": {"const": false},
        "formal_stages": {"type": "array", "items": {"enum": ["P4", "P5", "P6"]}, "uniqueItems": true},
        "local_only": {"const": true},
        "sync_action": {"const": "sync"}
      },
      "additionalProperties": false
    },
    "academic_quality": {
      "type": "object",
      "required": ["profile", "corpus_report", "paper_profile", "phases", "roles", "contest_evidence_eligible", "principles", "candidate_questions"],
      "properties": {
        "profile": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "corpus_report": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "paper_profile": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "phases": {"const": ["P1", "P2", "P3a", "P3b", "P4", "P5"]},
        "roles": {"const": ["solver", "literature", "visualization", "paper", "reviewer"]},
        "contest_evidence_eligible": {"const": false},
        "principles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "candidate_questions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["format", "chat_format", "required_fields", "detail_mode", "omit_empty_sections"],
      "properties": {
        "format": {"const": "compact_receipt"},
        "chat_format": {"const": "markdown_summary"},
        "required_fields": {
          "const": ["status", "objective", "conclusion", "evidence", "warnings", "next_action", "decision_request"]
        },
        "detail_mode": {"const": "on_request"},
        "omit_empty_sections": {"const": true}
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "required": ["P0", "P1", "P2", "P3a", "P3b", "P4", "P5", "P6"],
      "properties": {
        "P0": {"$ref": "#/$defs/rules"}, "P1": {"$ref": "#/$defs/rules"},
        "P2": {"$ref": "#/$defs/rules"}, "P3a": {"$ref": "#/$defs/rules"},
        "P3b": {"$ref": "#/$defs/rules"}, "P4": {"$ref": "#/$defs/rules"},
        "P5": {"$ref": "#/$defs/rules"}, "P6": {"$ref": "#/$defs/rules"}
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": ["orchestrator", "solver", "literature", "visualization", "paper", "studio_release", "reviewer"],
      "properties": {
        "orchestrator": {"$ref": "#/$defs/role"}, "solver": {"$ref": "#/$defs/role"},
        "literature": {"$ref": "#/$defs/role"}, "visualization": {"$ref": "#/$defs/role"},
        "paper": {"$ref": "#/$defs/role"}, "studio_release": {"$ref": "#/$defs/role"},
        "reviewer": {"$ref": "#/$defs/role"}
      },
      "additionalProperties": false
    },
    "role_stages": {
      "type": "object",
      "required": ["P0", "P1", "P2", "P3a", "P3b", "P4", "P5", "P6"],
      "properties": {
        "P0": {"const": ["orchestrator"]},
        "P1": {"const": ["orchestrator", "solver", "literature", "paper"]},
        "P2": {"const": ["orchestrator", "solver", "literature"]},
        "P3a": {"const": ["orchestrator", "solver", "literature", "visualization"]},
        "P3b": {"const": ["orchestrator", "solver", "literature", "visualization"]},
        "P4": {"const": ["orchestrator", "solver", "paper", "reviewer"]},
        "P5": {"const": ["orchestrator", "paper", "visualization", "literature", "reviewer"]},
        "P6": {"const": ["orchestrator", "studio_release", "reviewer"]}
      },
      "additionalProperties": false
    },
    "gate_sequence": {
      "type": "object",
      "required": ["P0", "P1", "P2", "P3a", "P3b", "P4", "P5", "P6"],
      "properties": {
        "P0": {"const": ["G0"]}, "P1": {"const": ["G0"]},
        "P2": {"const": ["G1"]}, "P3a": {"const": ["G1"]},
        "P3b": {"const": ["G2"]}, "P4": {"const": ["G3", "G4"]},
        "P5": {"const": ["G4"]}, "P6": {"const": ["G5", "G6"]}
      },
      "additionalProperties": false
    },
    "rules": {"$ref": "#/$defs/globalRules"}
  },
  "$defs": {
    "rules": {
      "type": "object",
      "required": ["gate", "objective", "allowed_actions", "blocking", "warning", "deferred", "stop_conditions", "escalation_conditions", "expected_artifacts"],
      "properties": {
        "gate": {"type": "string", "pattern": "^G[0-6]$"},
        "objective": {"type": "string", "minLength": 1},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "blocking": {"type": "array", "items": {"type": "string"}},
        "warning": {"type": "array", "items": {"type": "string"}},
        "deferred": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "items": {"type": "string"}},
        "escalation_conditions": {"type": "array", "items": {"type": "string"}},
        "expected_artifacts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["objective", "read_scope", "write_scope", "inputs", "outputs", "protected", "stop_conditions", "decisions"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "read_scope": {"type": "array", "items": {"type": "string"}},
        "write_scope": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "protected": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "globalRules": {
      "type": "object",
      "required": ["warning_does_not_block_exploration", "blocking_only_blocks_current_transition", "deferred_not_run_before_owner_stage", "hash_drift_invalidates_affected_question_only", "no_recursive_reaudit", "execution_semantics"],
      "properties": {
        "warning_does_not_block_exploration": {"const": true},
        "blocking_only_blocks_current_transition": {"const": true},
        "deferred_not_run_before_owner_stage": {"const": true},
        "hash_drift_invalidates_affected_question_only": {"const": true},
        "no_recursive_reaudit": {"const": true},
        "execution_semantics": {
          "type": "object",
          "required": ["warning", "blocking", "deferred", "hash_drift", "reaudit", "continuation", "note"],
          "properties": {
            "warning": {"const": "record-and-continue"},
            "blocking": {"const": "current-transition-only"},
            "deferred": {"const": "do-not-run-before-owner-stage"},
            "hash_drift": {"const": "affected-question-only"},
            "reaudit": {"const": "no-recursive-reaudit"},
            "continuation": {"const": "continue-editing-replay-and-recheckpoint"},
            "note": {"const": "当前检查只阻断本次阶段转换，不阻断本问题继续建模、修改、复跑或重新 checkpoint。"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
