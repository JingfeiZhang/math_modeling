{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.math-modeling/figure-contract-v2.schema.json",
  "title": "Mathematical Modeling Figure Contract v2",
  "type": "object",
  "required": [
    "contract_version", "id", "question_id", "claim_id", "core_conclusion",
    "evidence_chain", "kind", "archetype", "backend", "source_data",
    "source_script", "outputs", "baseline", "axes", "caption", "panel_map",
    "statistics", "review_risks", "final_width_mm", "min_font_pt"
  ],
  "properties": {
    "contract_version": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^fig-[a-z0-9-]+$"},
    "question_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "core_conclusion": {"type": "string", "minLength": 1},
    "core_message": {"type": "string", "minLength": 1},
    "evidence_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locator", "sha256", "fields"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "kind": {"enum": ["data", "schematic"]},
    "archetype": {"type": "string", "minLength": 1},
    "backend": {"enum": ["python", "matlab", "mermaid", "drawio"]},
    "target_size_profile": {"enum": ["contest-body", "journal-single", "journal-double"]},
    "visual_hierarchy": {
      "type": "object",
      "required": ["primary_evidence", "secondary_context", "deemphasized"],
      "properties": {
        "primary_evidence": {"type": "string", "minLength": 1},
        "secondary_context": {"type": "string", "minLength": 1},
        "deemphasized": {"type": "string", "minLength": 1}
      }
    },
    "palette_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "color_encoding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "meaning", "secondary_encoding"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "secondary_encoding": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_data": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_script": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "object",
      "required": ["pdf", "svg", "png", "png_dpi"],
      "properties": {
        "pdf": {"type": "string", "pattern": "\\.pdf$"},
        "svg": {"type": "string", "pattern": "\\.svg$"},
        "png": {"type": "string", "pattern": "\\.png$"},
        "png_dpi": {"const": 400}
      }
    },
    "baseline": {"type": "string", "minLength": 1},
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable", "unit"],
        "properties": {
          "variable": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "axes_not_applicable_reason": {"type": "string"},
    "caption": {"type": "string", "minLength": 1},
    "panel_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["panel", "role", "subclaim"],
        "properties": {
          "panel": {"type": "string"},
          "role": {"type": "string"},
          "subclaim": {"type": "string"}
        }
      }
    },
    "statistics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "statistics_report": {
      "type": "object",
      "required": ["sample_size", "center", "interval", "test", "multiplicity"],
      "properties": {
        "sample_size": {"type": "string", "minLength": 1},
        "center": {"type": "string", "minLength": 1},
        "interval": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "multiplicity": {"type": "string", "minLength": 1}
      }
    },
    "data_integrity": {
      "type": "object",
      "required": ["source_hashes", "transformation", "manual_values_forbidden"],
      "properties": {
        "source_hashes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "transformation": {"type": "string", "minLength": 1},
        "manual_values_forbidden": {"const": true}
      }
    },
    "label_strategy": {
      "type": "object",
      "required": ["mode", "collision_checked"],
      "properties": {
        "mode": {"enum": ["direct", "external-legend", "none"]},
        "collision_checked": {"const": true},
        "justification": {"type": "string"}
      }
    },
    "rasterized_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "reason"],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "multipanel_justification": {"type": "string"},
    "design_handoff": {
      "type": "object",
      "required": [
        "data_manifest", "data_manifest_sha256", "visual_intent", "visual_intent_sha256",
        "figure_brief", "figure_brief_sha256", "design_status", "render_qa", "render_qa_sha256"
      ],
      "properties": {
        "data_manifest": {"type": "string", "minLength": 1},
        "data_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visual_intent": {"type": "string", "minLength": 1},
        "visual_intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "figure_brief": {"type": "string", "minLength": 1},
        "figure_brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "design_status": {"const": "APPROVED"},
        "render_qa": {"type": "string", "minLength": 1},
        "render_qa_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "review_risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "final_width_mm": {"type": "number", "minimum": 40, "maximum": 190},
    "min_font_pt": {"type": "number", "minimum": 8}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "data"}}},
      "then": {"properties": {"axes": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"kind": {"const": "schematic"}}},
      "then": {"required": ["axes_not_applicable_reason"]}
    },
    {
      "if": {"properties": {"panel_map": {"minItems": 2}}},
      "then": {"required": ["multipanel_justification"]}
    }
  ]
}
